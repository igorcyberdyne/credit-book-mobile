CREATE TABLE TransactionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    localUuid TEXT NOT NULL,
    serverUuid TEXT,
    customerUuid TEXT NOT NULL,
    type TEXT NOT NULL,
    amountInCents INTEGER NOT NULL,
    description TEXT,
    paymentMethod TEXT,
    occurredAt TEXT,
    status TEXT NOT NULL,
    syncAttempts INTEGER NOT NULL DEFAULT 0
);

selectPending:
SELECT * FROM TransactionEntity WHERE status = 'pending';

selectForCustomer:
SELECT * FROM TransactionEntity WHERE customerUuid = :customerUuid AND status IN ('pending', 'error');

insertEntry:
INSERT INTO TransactionEntity(localUuid, customerUuid, type, amountInCents, description, paymentMethod, occurredAt, status, syncAttempts)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

markSynced:
UPDATE TransactionEntity SET status = 'synced', serverUuid = ? WHERE id = ?;

incrementSyncAttempts:
UPDATE TransactionEntity SET syncAttempts = syncAttempts + 1 WHERE id = ?;